# ~/.config/mako/config  (green + gold, tui style)

font=FreeMono 11
markup=1
format=<span foreground="#e3b82f"><b>%s</b></span>\n%b

anchor=top-right
layer=overlay
max-visible=5
sort=-time
group-by=app-name

background-color=#14150fee
text-color=#5c9e31
border-color=#e3b82f
progress-color=over #2f5a1c

border-size=2
border-radius=0

width=350
height=120
margin=12
padding=12

default-timeout=2500
ignore-timeout=false

icons=true
max-icon-size=40

[urgency=low]
border-color=#2f5a1c
text-color=#3f7a25
default-timeout=3000

[urgency=high]
border-color=#fb4934
background-color=#1c1410ee
default-timeout=2500
